@model List<RaceDay.Web.DTOs.EventResponse>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary fw-bold">📊 Organiser Dashboard</h1>
        <a asp-action="Create" class="btn btn-warning fw-bold">➕ Create New Event</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info shadow-sm">You haven't created any events yet. Click the button above to get started!</div>
            </div>
        }
        else
        {
            @foreach (var ev in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <span class="badge bg-dark mb-2">@ev.Status</span>
                            <h5 class="card-title fw-bold">@ev.Name</h5>
                            <p class="text-muted small mb-2">@ev.Location</p>
                            <p class="text-muted small">Total Enrolments: @ev.Categories.Sum(c => c.EnrolledCount)</p>

                            <!-- UPDATED BUTTON SECTION -->
                            <div class="mt-3 d-flex gap-2">
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-outline-primary btn-sm w-50">View Page</a>
                                <a asp-controller="Events" asp-action="CreateCategory" asp-route-eventId="@ev.EventId" class="btn btn-warning btn-sm w-50">➕ Add Category</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>