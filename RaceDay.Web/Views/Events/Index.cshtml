@model List<RaceDay.Web.DTOs.EventResponse>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container mt-4">
    <h1 class="text-primary fw-bold mb-4">🏃‍♂️ Upcoming Races</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 shadow-sm">
            <h4 class="alert-heading">No events found!</h4>
            <p class="mb-0">Organisers haven't created any events yet. Check back later!</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var ev in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-warning text-dark mb-2 align-self-start">@ev.EventType</span>
                            <h5 class="card-title fw-bold">@ev.Name</h5>
                            <p class="card-text text-muted mb-1">📍 @ev.Location</p>
                            <p class="card-text text-muted mb-3">📅 @ev.Date.ToString("MMM dd, yyyy")</p>

                            <a asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-outline-primary w-100 mt-auto fw-bold">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>