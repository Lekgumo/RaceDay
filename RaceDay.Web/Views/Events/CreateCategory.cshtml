@model RaceDay.Web.DTOs.CreateCategoryRequest
@{
    ViewData["Title"] = "Add Category";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">Add Category to Event</h4>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-action="CreateCategory" asp-route-eventId="@ViewBag.EventId" method="post">
                        <div class="mb-3">
                            <label class="fw-bold">Category Name</label>
                            <input asp-for="Name" class="form-control" required placeholder="e.g. 10km Fun Run" />
                        </div>
                        <div class="mb-3">
                            <label class="fw-bold">Description</label>
                            <input asp-for="Description" class="form-control" />
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <label class="fw-bold">Entry Fee (R)</label>
                                <input asp-for="EntryFee" type="number" step="0.01" class="form-control" required />
                            </div>
                            <div class="col">
                                <label class="fw-bold">Max Capacity</label>
                                <input asp-for="MaxCapacity" type="number" class="form-control" required />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-warning w-100 fw-bold">Add Category</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>