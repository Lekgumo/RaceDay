<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <!-- The Dark RaceDay Navbar -->
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark shadow-sm mb-4">
            <div class="container-fluid">
                <!-- Logo -->
                <a class="navbar-brand text-warning fw-bold fs-4" asp-controller="Events" asp-action="Index">
                    🏃 RaceDay
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Left Side Links -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Events" asp-action="Index">Browse Events</a>
                        </li>

                        <!-- Organiser Links -->
                        @if (Context.Session.GetString("UserRole") == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-info fw-bold" asp-controller="Organiser" asp-action="Dashboard">Organiser Dashboard</a>
                            </li>
                        }

                        <!-- Participant Links -->
                        @if (Context.Session.GetString("UserRole") == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-success fw-bold" asp-controller="Participant" asp-action="MyEnrolments">My Enrolments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-success fw-bold" asp-controller="Participant" asp-action="MyResults">My Results</a>
                            </li>
                        }
                    </ul>

                    <!-- Right Side Links (Auth) -->
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("UserEmail") != null)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-light">👤 @Context.Session.GetString("UserName")</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-controller="Auth" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Auth" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="Auth" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted mt-5 bg-white">
        <div class="container text-center py-3">
            &copy; 2026 - RaceDay - IIE PROG6212
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>