@model RaceDay.Web.DTOs.LoginRequest
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow border-0">
            <div class="card-body p-4">
                <h2 class="text-center text-primary fw-bold mb-4">Login to RaceDay</h2>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input asp-for="Email" class="form-control" type="email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Password</label>
                        <input asp-for="Password" class="form-control" type="password" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-bold">Login</button>
                </form>

                <div class="text-center mt-3">
                    <a asp-action="Register">Don't have an account? Register here.</a>
                </div>
            </div>
        </div>
    </div>
</div>