@model List<RaceDay.Web.DTOs.EnrolmentResponse>
@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h1 class="text-primary fw-bold mb-4">🏃 My Enrolments</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">You haven't enrolled in any events yet. <a asp-controller="Events" asp-action="Index">Browse Events</a></div>
    }
    else
    {
        <div class="row">
            @foreach (var en in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title fw-bold text-primary mb-0">@en.EventName</h5>
                                @if (en.Status == "Confirmed" || en.Status == "Completed")
                                {
                                    <span class="badge bg-success">@en.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@en.Status</span>
                                }
                            </div>
                            <p class="card-text text-muted mb-1">🏷️ Category: <strong>@en.CategoryName</strong></p>
                            <p class="card-text text-muted mb-1">📅 Enrolled on: @en.EnrolmentDate.ToString("MMM dd, yyyy")</p>

                            @if (en.BibNumber.HasValue)
                            {
                                <div class="mt-3 p-2 bg-dark text-warning text-center rounded">
                                    <strong>BIB NUMBER: @en.BibNumber</strong>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>